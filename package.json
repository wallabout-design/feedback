{
  "name": "@wallabout-design/feedback",
  "version": "0.3.0",
  "description": "Hidden 'send feedback' link for wallabout sites: a prefilled email with the page, viewport, build and highlighted text",
  "license": "UNLICENSED",
  "repository": "github:wallabout-design/feedback",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./reserve.css": "./dist/reserve.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/reserve.css dist/reserve.css",
    "check": "tsc -p tsconfig.test.json",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "verify": "npm run check && npm test",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
